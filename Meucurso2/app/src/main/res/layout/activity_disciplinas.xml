<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho Verde -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_green"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GRADUAÇÃO"
                android:textColor="#B2DFDB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disciplinas do Curso"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Lista de Cards das Disciplinas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="-16dp">

            <!-- Programação -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProgramacao"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Programação"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <!-- Banco de Dados -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBancoDados"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Banco de Dados"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <!-- Engenharia de Software -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEngenharia"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Engenharia de Software"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <!-- Desenvolvimento Web -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWeb"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Desenvolvimento Web"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <!-- Desenvolvimento Mobile -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMobile"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Desenvolvimento Mobile"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <!-- Inteligência Artificial -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIA"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Inteligência Artificial"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#FFFFFF"
                android:layout_marginBottom="24dp"/>

            <!-- Botão Voltar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoltar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="VOLTAR"
                android:textColor="@color/primary_green"
                android:textStyle="bold"
                android:textSize="14sp"
                app:strokeColor="@color/primary_green"
                app:strokeWidth="1.5dp"
                app:cornerRadius="27dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>